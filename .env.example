# Copy to .env.local for development. On Vercel, set these in
# Project -> Settings -> Environment Variables (Production AND Preview).
#
# Only the first two are required. Everything else degrades to a deterministic
# fallback rather than failing, so the app boots with no third-party keys at all.

# --- required -----------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string -> Transaction
# pooler (port 6543). NOT the direct 5432 connection: a serverless function
# opens a connection per instance and would exhaust the direct limit.
# Append ?pgbouncer=true&sslmode=require
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require

# openssl rand -base64 32
AUTH_SECRET=

# The deployment's own URL. Signed mandates and the protocol manifests embed
# it, so a wrong value produces links that resolve to the wrong host.
PLATFORM_URL=https://your-app.vercel.app

# --- AI (optional; every one has a no-card free tier) --------------------
LLM_PRIMARY=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Failover, tried in order when the primary is rate-limited.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Leave UNSET. Setting it starts a local model, which a serverless
# function has neither the disk nor the time for.
# OLLAMA_BASE_URL=

# --- embeddings ---------------------------------------------------------
# Local, 384-dimensional, no key and no quota. The weights are baked into the
# build by `npm run prebuild`; do not change the model or dtype without
# re-indexing, since existing vectors would no longer be comparable.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# --- payments -----------------------------------------------------------
# Test mode only. RazorpayGateway throws if the key is not rzp_test_.
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- storage ------------------------------------------------------------
# MUST be `supabase` on Vercel: the local driver writes to the filesystem,
# which is read-only outside /tmp and does not survive an invocation.
STORAGE_DRIVER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
